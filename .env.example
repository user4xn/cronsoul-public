# Copy to .env next to docker-compose.yml, or export these before `go run`.
# Nothing here is needed for a local trial: dev mode derives a key and uses an
# in-memory database. Fill it in the moment you want data to survive a restart.

# Key that encrypts notification/channel credentials. Three ways to provide it:
#   1. leave both empty in dev        -> a key is derived automatically
#   2. CRONSOUL_SECRET_KEY_FILE=path  -> read from file, created on first boot
#   3. CRONSOUL_SECRET_KEY=...        -> 32 bytes, raw or base64 (openssl rand -base64 32)
# Rotating the key makes existing channel configs unreadable: re-enter them.
CRONSOUL_SECRET_KEY=
# CRONSOUL_SECRET_KEY_FILE=/data/secret.key

# dev | production
CRONSOUL_ENV=dev

# Where the SQLite file lives. Defaults to :memory: in dev, which forgets
# everything on restart; point it at a file for a realistic trial.
CRONSOUL_DB=./cronsoul.db

# Address to bind. Use :9470 for local, :80 behind a proxy.
CRONSOUL_LISTEN=:9470

# cert | proxy | off. "off" is dev-only; behind nginx/caddy use proxy.
CRONSOUL_TLS_MODE=off
# CRONSOUL_TLS_CERT=/etc/cronsoul/fullchain.pem
# CRONSOUL_TLS_KEY=/etc/cronsoul/privkey.pem

# Public URL, required outside dev (https only).
# CRONSOUL_BASE_URL=https://cronsoul.example.com

# Timezone every timestamp in the console is rendered in (changeable in Settings).
CRONSOUL_DISPLAY_TZ=Asia/Jakarta

# Session lifetime, Go duration syntax.
CRONSOUL_SESSION_TTL=12h
